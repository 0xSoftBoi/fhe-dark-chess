# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Sepolia JSON-RPC endpoint (Infura/Alchemy/QuickNode key URL, or a public RPC).
SEPOLIA_RPC_URL=

# Private key (0x-prefixed) of a FUNDED Sepolia account — used to deploy and to play.
# Get testnet ETH from a Sepolia faucet (see DEPLOY.md).
PRIVATE_KEY=

# Address printed by `npx hardhat run scripts/deploy.js --network sepolia`.
# Required by scripts/play.js; leave blank until after you deploy.
FOGCHESS_ADDRESS=
